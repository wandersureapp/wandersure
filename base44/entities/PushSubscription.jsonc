{
  "name": "PushSubscription",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user who subscribed"
    },
    "endpoint": {
      "type": "string",
      "description": "Push notification endpoint URL"
    },
    "keys": {
      "type": "object",
      "properties": {
        "p256dh": {
          "type": "string"
        },
        "auth": {
          "type": "string"
        }
      },
      "description": "Encryption keys for push notifications"
    },
    "device_info": {
      "type": "string",
      "description": "Browser/device information"
    }
  },
  "required": [
    "user_email",
    "endpoint",
    "keys"
  ],
  "rls": {
    "create": {
      "user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_email": "{{user.email}}"
    },
    "delete": {
      "user_email": "{{user.email}}"
    }
  }
}
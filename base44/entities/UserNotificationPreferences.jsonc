{
  "name": "UserNotificationPreferences",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user these preferences belong to"
    },
    "subscription_tier": {
      "type": "string",
      "enum": [
        "free",
        "premium",
        "elite"
      ],
      "default": "free",
      "description": "User's subscription tier"
    },
    "email_enabled": {
      "type": "boolean",
      "default": true
    },
    "in_app_enabled": {
      "type": "boolean",
      "default": true
    },
    "sms_enabled": {
      "type": "boolean",
      "default": false
    },
    "sms_number": {
      "type": "string",
      "description": "Phone number for SMS alerts"
    },
    "alert_types": {
      "type": "object",
      "properties": {
        "trip_reminders": {
          "type": "boolean",
          "default": true,
          "description": "Trip countdown and departure reminders (Free)"
        },
        "major_risk_alerts": {
          "type": "boolean",
          "default": true,
          "description": "Critical safety warnings and severe weather (Free)"
        },
        "flight_updates": {
          "type": "boolean",
          "default": true,
          "description": "Real-time flight delays, cancellations, gate changes (Premium)"
        },
        "airport_intelligence": {
          "type": "boolean",
          "default": true,
          "description": "Live TSA wait times, traffic, parking availability (Premium)"
        },
        "weather_updates": {
          "type": "boolean",
          "default": true,
          "description": "Detailed weather forecasts and storm tracking (Premium)"
        },
        "destination_safety": {
          "type": "boolean",
          "default": true,
          "description": "Real-time safety and political updates (Premium)"
        },
        "hotel_updates": {
          "type": "boolean",
          "default": true,
          "description": "Hotel check-in status, room availability changes (Premium)"
        },
        "car_rental_updates": {
          "type": "boolean",
          "default": true,
          "description": "Rental car availability, pickup location changes (Premium)"
        },
        "cruise_updates": {
          "type": "boolean",
          "default": true,
          "description": "Cruise departure times, port changes, excursion alerts (Premium)"
        },
        "rail_updates": {
          "type": "boolean",
          "default": true,
          "description": "Train/rail delays, platform changes, service disruptions (Premium)"
        },
        "insurance_recommendations": {
          "type": "boolean",
          "default": true,
          "description": "Coverage suggestions based on risk changes (Premium)"
        },
        "price_drop_alerts": {
          "type": "boolean",
          "default": true,
          "description": "Insurance premium price drops (Premium)"
        }
      }
    }
  },
  "required": [
    "user_email"
  ]
}
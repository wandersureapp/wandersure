{
  "name": "TravelChecklist",
  "type": "object",
  "properties": {
    "trip_id": {
      "type": "string",
      "description": "Associated trip ID"
    },
    "has_premium": {
      "type": "boolean",
      "default": false,
      "description": "Whether user purchased premium checklist features"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "documents",
              "packing",
              "bookings",
              "health",
              "money",
              "technology",
              "pre_departure",
              "day_of"
            ]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "completed": {
            "type": "boolean",
            "default": false
          },
          "due_days_before_departure": {
            "type": "number",
            "description": "How many days before trip this should be done"
          },
          "is_custom": {
            "type": "boolean",
            "default": false,
            "description": "Whether this was added by user"
          },
          "ai_generated": {
            "type": "boolean",
            "default": false,
            "description": "Whether AI suggested this item"
          },
          "completed_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "completion_percentage": {
      "type": "number",
      "default": 0
    },
    "alerts_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Send reminder alerts for incomplete items"
    }
  },
  "required": [
    "trip_id"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
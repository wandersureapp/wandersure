{
  "name": "Send Welcome Email After First Risk Assessment",
  "description": "Automatically sends a welcome email with risk assessment summary and upgrade options when a new trip is created",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Trip"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "send_welcome_email_after_first_risk_assessment",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendInitialRiskEmail",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendInitialRiskEmail"
  }
}